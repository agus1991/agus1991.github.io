---
import { formatDate } from '../utils/formatDate';
import { calculateReadingTime } from '../utils/readingTime';
import type { SupportedLang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date | string;
  category: string;
  tags?: string[];
  cover?: string;
  coverAlt?: string;
  body?: string;
  lang?: SupportedLang;
}

const {
  title,
  description,
  slug,
  pubDate,
  category,
  tags = [],
  cover,
  coverAlt = title,
  body = '',
  lang = 'id'
} = Astro.props;

const isEn = lang === 'en';
const readingTime = calculateReadingTime(body || description);
const formattedDate = formatDate(pubDate);
const href = isEn ? `/en/blog/${slug}` : `/blog/${slug}`;
const categoryHref = isEn ? `/en/blog?category=${encodeURIComponent(category)}` : `/blog?category=${encodeURIComponent(category)}`;
---

<article class="editorial-card group flex flex-col justify-between bg-surface-light dark:bg-surface-dark border border-borderline-light dark:border-borderline-dark rounded-md overflow-hidden p-6 transition-all duration-300">
  <div>
    <!-- Cover Image if present -->
    {cover && (
      <a href={href} class="block mb-5 overflow-hidden rounded bg-canvas-light dark:bg-canvas-dark aspect-[16/9] relative">
        <img
          src={cover}
          alt={coverAlt}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      </a>
    )}

    <!-- Category & Date Meta -->
    <div class="flex items-center space-x-2 text-xs text-ink-secondary-light dark:text-ink-secondary-dark mb-3">
      <a
        href={categoryHref}
        class="font-semibold text-accent-light dark:text-accent-dark hover:underline uppercase tracking-wider text-[11px]"
      >
        {category}
      </a>
      <span>•</span>
      <time datetime={new Date(pubDate).toISOString()}>{formattedDate}</time>
      <span>•</span>
      <span>{readingTime}</span>
    </div>

    <!-- Title -->
    <h3 class="font-serif text-xl sm:text-2xl font-bold leading-snug mb-3 text-ink-primary-light dark:text-ink-primary-dark group-hover:text-accent-light dark:group-hover:text-accent-dark transition-colors">
      <a href={href} class="focus:outline-none">
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-sm leading-relaxed text-ink-secondary-light dark:text-ink-secondary-dark line-clamp-3 mb-4">
      {description}
    </p>
  </div>

  <!-- Tags and Read More -->
  <div class="pt-4 border-t border-borderline-light/50 dark:border-borderline-dark/50 flex items-center justify-between mt-auto">
    <div class="flex flex-wrap gap-1.5">
      {tags.slice(0, 2).map((tag) => (
        <a
          href={isEn ? `/en/blog?tag=${encodeURIComponent(tag)}` : `/blog?tag=${encodeURIComponent(tag)}`}
          class="text-[11px] px-2 py-0.5 rounded bg-canvas-light dark:bg-canvas-dark text-ink-secondary-light dark:text-ink-secondary-dark hover:text-accent-light dark:hover:text-accent-dark transition-colors"
        >
          #{tag}
        </a>
      ))}
    </div>
    <a
      href={href}
      class="text-xs font-semibold text-accent-light dark:text-accent-dark hover:text-accent-hover transition-colors flex items-center space-x-1"
      aria-label={`${isEn ? 'Read article' : 'Baca selengkapnya artikel'} ${title}`}
    >
      <span>{isEn ? 'Read' : 'Baca'}</span>
      <span>&rarr;</span>
    </a>
  </div>
</article>
