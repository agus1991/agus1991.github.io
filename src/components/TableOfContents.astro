---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav class="toc-container p-5 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark my-6" aria-label="Daftar Isi">
    <h3 class="font-serif text-sm font-semibold tracking-wider uppercase text-ink-primary-light dark:text-ink-primary-dark mb-3 flex items-center space-x-2">
      <span>Daftar Isi Artikel</span>
    </h3>
    <ul class="space-y-2 text-sm">
      {filteredHeadings.map((heading) => (
        <li class={heading.depth === 3 ? 'pl-4 text-xs' : ''}>
          <a
            href={`#${heading.slug}`}
            class="text-ink-secondary-light dark:text-ink-secondary-dark hover:text-accent-light dark:hover:text-accent-dark transition-colors inline-block leading-snug"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
