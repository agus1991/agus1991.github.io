---
import { getLangFromUrl, getLocalizedPath, type SupportedLang } from '../i18n/ui';

interface Props {
  alternateUrl?: {
    id?: string;
    en?: string;
  };
  class?: string;
}

const { alternateUrl, class: className = '' } = Astro.props;

const currentPath = Astro.url.pathname;
const currentLang = getLangFromUrl(Astro.url);

const idHref = alternateUrl?.id || getLocalizedPath(currentPath, 'id');
const enHref = alternateUrl?.en || getLocalizedPath(currentPath, 'en');
---

<div
  class={`inline-flex items-center text-xs font-semibold rounded-lg border border-borderline-light dark:border-borderline-dark p-0.5 bg-surface-light dark:bg-surface-dark shadow-xs transition-colors ${className}`}
  role="group"
  aria-label="Language selection"
>
  <!-- Indonesian Option -->
  <a
    href={idHref}
    lang="id"
    hreflang="id"
    class={`px-2.5 py-1 rounded-md transition-all duration-150 ${
      currentLang === 'id'
        ? 'bg-accent-light text-white dark:bg-accent-dark dark:text-canvas-dark font-bold shadow-xs'
        : 'text-ink-secondary-light dark:text-ink-secondary-dark hover:text-ink-primary-light dark:hover:text-ink-primary-dark hover:bg-canvas-light/60 dark:hover:bg-canvas-dark/60'
    }`}
    aria-current={currentLang === 'id' ? 'page' : undefined}
    title="Bahasa Indonesia"
  >
    ID
  </a>

  <!-- English Option -->
  <a
    href={enHref}
    lang="en"
    hreflang="en"
    class={`px-2.5 py-1 rounded-md transition-all duration-150 ${
      currentLang === 'en'
        ? 'bg-accent-light text-white dark:bg-accent-dark dark:text-canvas-dark font-bold shadow-xs'
        : 'text-ink-secondary-light dark:text-ink-secondary-dark hover:text-ink-primary-light dark:hover:text-ink-primary-dark hover:bg-canvas-light/60 dark:hover:bg-canvas-dark/60'
    }`}
    aria-current={currentLang === 'en' ? 'page' : undefined}
    title="English"
  >
    EN
  </a>
</div>
