---
import AdSlot from './AdSlot.astro';
import siteData from '../data/site.json';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const slotId = siteData.adsense.slotSidebar;
---

<AdSlot
  slotId={slotId}
  format="rectangle"
  responsive={false}
  className={`w-full max-w-[300px] mx-auto ${className}`}
/>
