---
import PageLayout from '../layouts/PageLayout.astro';
import profileData from '../data/profile.json';
import socialData from '../data/social.json';
import researchData from '../data/research.json';
import siteData from '../data/site.json';
import { generateProfilePageSchema } from '../utils/seo';

const pageUrl = `${siteData.siteUrl}/about`;
const profileSchema = generateProfilePageSchema(pageUrl);

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Tentang Saya', url: '/about' }
];
---

<PageLayout
  title={`Tentang ${profileData.name} (${profileData.brand})`}
  description={`Biografi profesional, riwayat akademis, dan bidang keahlian Agus Sifaunajah di bidang Sistem Informasi dan Riset Komputasi.`}
  headline={`Tentang ${profileData.name}`}
  subheadline={profileData.headline}
  breadcrumbs={breadcrumbs}
  schemas={[profileSchema]}
  canonicalUrl={pageUrl}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    <!-- Main Content Column -->
    <div class="lg:col-span-8 space-y-12">
      <!-- Biography -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark pb-3 border-b border-borderline-light dark:border-borderline-dark">
          Biografi Profesional
        </h2>
        <div class="space-y-4 text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed text-base">
          {profileData.fullBio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>

      <!-- Areas of Expertise -->
      <section class="space-y-6">
        <h2 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark pb-3 border-b border-borderline-light dark:border-borderline-dark">
          Bidang Keahlian &amp; Kompetensi
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {profileData.expertise.map((item) => (
            <div class="p-5 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark space-y-2">
              <h3 class="font-serif text-base font-semibold text-ink-primary-light dark:text-ink-primary-dark">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Academic Background -->
      <section class="space-y-6">
        <h2 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark pb-3 border-b border-borderline-light dark:border-borderline-dark">
          Latar Belakang Akademis
        </h2>
        <div class="space-y-4">
          {profileData.academicBackground.map((item) => (
            <div class="p-5 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs text-ink-secondary-light dark:text-ink-secondary-dark mb-1">
                <span class="font-semibold text-accent-light dark:text-accent-dark">{item.period}</span>
                <span>{item.institution}</span>
              </div>
              <h3 class="font-serif text-lg font-bold text-ink-primary-light dark:text-ink-primary-dark mb-2">
                {item.degree}
              </h3>
              <p class="text-xs sm:text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed">
                {item.focus}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Professional Experience -->
      <section class="space-y-6">
        <h2 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark pb-3 border-b border-borderline-light dark:border-borderline-dark">
          Riwayat Profesional &amp; Aktivitas
        </h2>
        <div class="space-y-6 border-l-2 border-borderline-light dark:border-borderline-dark pl-6 ml-2">
          {profileData.experience.map((item) => (
            <div class="relative space-y-1">
              <div class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-accent-light dark:bg-accent-dark"></div>
              <div class="flex flex-wrap items-center gap-2 text-xs text-ink-secondary-light dark:text-ink-secondary-dark">
                <span class="font-bold text-accent-light dark:text-accent-dark">{item.period}</span>
                <span>•</span>
                <span>{item.institution}</span>
              </div>
              <h3 class="font-serif text-lg font-semibold text-ink-primary-light dark:text-ink-primary-dark">
                {item.role}
              </h3>
              <p class="text-xs sm:text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- Sidebar Column -->
    <div class="lg:col-span-4 space-y-8">
      <!-- Profile Card -->
      <div class="p-6 rounded-lg border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark space-y-5">
        <div class="w-36 h-36 mx-auto rounded-full overflow-hidden border-2 border-accent-light dark:border-accent-dark p-0.5 bg-canvas-light dark:bg-canvas-dark">
          <img
            src={profileData.avatar}
            alt={profileData.name}
            class="w-full h-full object-cover rounded-full"
            loading="eager"
          />
        </div>

        <div class="text-center space-y-1">
          <h3 class="font-serif text-xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
            {profileData.name}
          </h3>
          <p class="text-xs text-accent-light dark:text-accent-dark font-medium uppercase tracking-wider">
            {profileData.brand}
          </p>
          <p class="text-xs text-ink-secondary-light dark:text-ink-secondary-dark pt-1">
            {profileData.headline}
          </p>
        </div>

        <div class="pt-4 border-t border-borderline-light dark:border-borderline-dark space-y-2.5 text-xs text-ink-secondary-light dark:text-ink-secondary-dark">
          <div class="flex items-center justify-between">
            <span class="font-medium">Lokasi:</span>
            <span>{profileData.location}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="font-medium">Status:</span>
            <span class="text-accent-light dark:text-accent-dark font-semibold">Tersedia untuk Kolaborasi</span>
          </div>
        </div>
      </div>

      <!-- Professional Links & Profiles -->
      <div class="p-6 rounded-lg border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark space-y-4">
        <h3 class="font-serif text-base font-semibold text-ink-primary-light dark:text-ink-primary-dark">
          Profil &amp; Jejaring Akademik
        </h3>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a
              href={socialData.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-canvas-light dark:hover:bg-canvas-dark text-ink-secondary-light dark:text-ink-secondary-dark hover:text-ink-primary-light dark:hover:text-ink-primary-dark transition-colors"
            >
              <span>GitHub</span>
              <span class="text-accent-light dark:text-accent-dark font-mono">@agus1991 &rarr;</span>
            </a>
          </li>
          <li>
            <a
              href={socialData.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-canvas-light dark:hover:bg-canvas-dark text-ink-secondary-light dark:text-ink-secondary-dark hover:text-ink-primary-light dark:hover:text-ink-primary-dark transition-colors"
            >
              <span>LinkedIn</span>
              <span class="text-accent-light dark:text-accent-dark">&rarr;</span>
            </a>
          </li>
          <li>
            <a
              href={socialData.googleScholar}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-canvas-light dark:hover:bg-canvas-dark text-ink-secondary-light dark:text-ink-secondary-dark hover:text-ink-primary-light dark:hover:text-ink-primary-dark transition-colors"
            >
              <span>Google Scholar</span>
              <span class="text-accent-light dark:text-accent-dark">&rarr;</span>
            </a>
          </li>
          <li>
            <a
              href={socialData.orcid}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-canvas-light dark:hover:bg-canvas-dark text-ink-secondary-light dark:text-ink-secondary-dark hover:text-ink-primary-light dark:hover:text-ink-primary-dark transition-colors"
            >
              <span>ORCID</span>
              <span class="text-accent-light dark:text-accent-dark">&rarr;</span>
            </a>
          </li>
          <li>
            <a
              href={socialData.mainDomain}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-canvas-light dark:hover:bg-canvas-dark text-ink-secondary-light dark:text-ink-secondary-dark hover:text-ink-primary-light dark:hover:text-ink-primary-dark transition-colors"
            >
              <span>AskaPubliser</span>
              <span class="text-accent-light dark:text-accent-dark">&rarr;</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</PageLayout>
