---
import PageLayout from '../../layouts/PageLayout.astro';
import researchData from '../../data/research.json';
import siteData from '../../data/site.json';
import profileData from '../../data/profile.json';

const pageUrl = `${siteData.siteUrl}/research`;

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Riset', url: '/research' }
];
---

<PageLayout
  title={`Riset & Roadmap Penelitian — ${siteData.name}`}
  description="Fokus riset terapan, roadmap penelitian sistem informasi, metodologi DSRM, dan inovasi komputasi oleh Agus Sifaunajah."
  headline="Riset & Roadmap Penelitian"
  subheadline="Menjembatani landasan teoritis sistem informasi dengan rekayasa terapan untuk menjawab tantangan operasional dan kematangan digital organisasi."
  breadcrumbs={breadcrumbs}
  canonicalUrl={pageUrl}
>
  <div class="space-y-16">
    <!-- Section 1: Research Interests -->
    <section>
      <div class="mb-8 pb-3 border-b border-borderline-light dark:border-borderline-dark">
        <h2 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
          Fokus &amp; Minat Penelitian Utama
        </h2>
        <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
          Area keilmuan yang menjadi pusat eksplorasi riset dan publikasi akademis
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {researchData.interests.map((item) => (
          <div class="p-6 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark space-y-3">
            <h3 class="font-serif text-xl font-semibold text-ink-primary-light dark:text-ink-primary-dark">
              {item.title}
            </h3>
            <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed">
              {item.description}
            </p>
            <div class="pt-2 flex flex-wrap gap-1.5">
              {item.tags.map((tag) => (
                <span class="text-[11px] px-2.5 py-0.5 rounded bg-canvas-light dark:bg-canvas-dark border border-borderline-light dark:border-borderline-dark text-ink-secondary-light dark:text-ink-secondary-dark">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 2: Ongoing Research -->
    <section>
      <div class="mb-8 pb-3 border-b border-borderline-light dark:border-borderline-dark">
        <h2 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
          Riset yang Sedang Berjalan (Ongoing Research)
        </h2>
        <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
          Investigasi aktif dan proyek studi terapan yang sedang dalam proses pengumpulan data dan pengujian
        </p>
      </div>

      <div class="space-y-6">
        {researchData.ongoing.map((item) => (
          <div class="p-6 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-accent-muted text-accent-light dark:text-accent-dark">
                {item.status}
              </span>
              <span class="text-xs text-ink-secondary-light dark:text-ink-secondary-dark font-medium">
                Periode: {item.period}
              </span>
            </div>

            <h3 class="font-serif text-xl font-bold text-ink-primary-light dark:text-ink-primary-dark mb-2">
              {item.title}
            </h3>

            <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed mb-4">
              {item.description}
            </p>

            <div class="pt-3 border-t border-borderline-light/50 dark:border-borderline-dark/50 text-xs">
              <span class="font-semibold text-ink-primary-light dark:text-ink-primary-dark">Metodologi Riset: </span>
              <span class="text-ink-secondary-light dark:text-ink-secondary-dark">{item.methodology}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 3: Research Methodologies -->
    <section>
      <div class="mb-8 pb-3 border-b border-borderline-light dark:border-borderline-dark">
        <h2 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
          Pendekatan &amp; Metodologi Riset
        </h2>
        <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
          Kerangka kerja ilmiah yang diimplementasikan dalam pengembangan dan evaluasi artefak
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {researchData.methodologies.map((method) => (
          <div class="p-6 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark space-y-2">
            <h3 class="font-serif text-lg font-bold text-ink-primary-light dark:text-ink-primary-dark">
              {method.name}
            </h3>
            <p class="text-xs sm:text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed">
              {method.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 4: Research Roadmap -->
    <section>
      <div class="mb-8 pb-3 border-b border-borderline-light dark:border-borderline-dark">
        <h2 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
          Roadmap &amp; Rencana Strategis Riset
        </h2>
        <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
          Lintasan jangka panjang penelitian menuju ekosistem sistem informasi yang matang dan berkelanjutan
        </p>
      </div>

      <div class="relative border-l-2 border-accent-light dark:border-accent-dark ml-4 pl-6 space-y-8">
        {researchData.roadmap.map((stage) => (
          <div class="relative">
            <div class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-accent-light dark:bg-accent-dark ring-4 ring-canvas-light dark:ring-canvas-dark"></div>
            <div class="flex items-center space-x-2 text-xs text-ink-secondary-light dark:text-ink-secondary-dark mb-1">
              <span class="font-bold text-accent-light dark:text-accent-dark uppercase tracking-wider">{stage.phase}</span>
              <span>•</span>
              <span class="px-2 py-0.2 rounded bg-surface-light dark:bg-surface-dark border border-borderline-light dark:border-borderline-dark text-[10px]">{stage.status}</span>
            </div>
            <h3 class="font-serif text-lg font-bold text-ink-primary-light dark:text-ink-primary-dark mb-1">
              {stage.title}
            </h3>
            <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed">
              {stage.summary}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <div class="p-8 rounded-lg border border-borderline-light dark:border-borderline-dark bg-canvas-light dark:bg-canvas-dark text-center space-y-4">
      <h3 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
        Tertarik Mengadakan Riset Kolaboratif?
      </h3>
      <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark max-w-xl mx-auto leading-relaxed">
        Peluang co-authoring naskah ilmiah, riset hibah, atau penerapan studi kasus di institusi Anda dapat didiskusikan secara terbuka.
      </p>
      <div class="pt-2">
        <a
          href="/contact"
          class="inline-block px-5 py-2.5 text-xs font-semibold rounded bg-accent-light text-white dark:bg-accent-dark dark:text-canvas-dark hover:bg-accent-hover transition-colors"
        >
          Ajukan Diskusi Riset &rarr;
        </a>
      </div>
    </div>
  </div>
</PageLayout>
