---
import PageLayout from '../../../layouts/PageLayout.astro';
import researchData from '../../../data/en/research.json';
import siteData from '../../../data/site.json';
import profileData from '../../../data/en/profile.json';

const pageUrl = `${siteData.siteUrl}/en/research`;

const breadcrumbs = [
  { name: 'Home', url: '/en' },
  { name: 'Research', url: '/en/research' }
];
---

<PageLayout
  title={`Research Agenda & Methodologies — ${siteData.name}`}
  description="Applied research focus, research roadmap, Design Science Research Methodology (DSRM), and computing innovation by Agus Sifaunajah."
  headline="Research Agenda &amp; Focus"
  subheadline="Bridging theoretical information systems foundations with applied software and network engineering to solve real-world organizational challenges."
  breadcrumbs={breadcrumbs}
  canonicalUrl={pageUrl}
  lang="en"
>
  <div class="space-y-16">
    <!-- Section 1: Research Interests -->
    <section>
      <div class="mb-8 pb-3 border-b border-borderline-light dark:border-borderline-dark">
        <h2 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
          Core Research Interests
        </h2>
        <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
          Specialized domains driving scholarly inquiry and peer-reviewed publishing
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {researchData.interests.map((item) => (
          <div class="p-6 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark space-y-3">
            <h3 class="font-serif text-xl font-semibold text-ink-primary-light dark:text-ink-primary-dark">
              {item.title}
            </h3>
            <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed">
              {item.description}
            </p>
            <div class="pt-2 flex flex-wrap gap-1.5">
              {item.tags.map((tag) => (
                <span class="text-[11px] px-2.5 py-0.5 rounded bg-canvas-light dark:bg-canvas-dark border border-borderline-light dark:border-borderline-dark text-ink-secondary-light dark:text-ink-secondary-dark">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 2: Ongoing Research -->
    <section>
      <div class="mb-8 pb-3 border-b border-borderline-light dark:border-borderline-dark">
        <h2 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
          Ongoing Research Projects
        </h2>
        <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
          Active investigations currently in empirical prototyping, validation, or dissemination stages
        </p>
      </div>

      <div class="space-y-6">
        {researchData.ongoing.map((item) => (
          <div class="p-6 rounded-lg border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
              <span class="px-2.5 py-0.5 rounded-full font-semibold bg-accent-muted text-accent-light dark:text-accent-dark text-[11px]">
                {item.status}
              </span>
              <span class="font-mono text-ink-secondary-light dark:text-ink-secondary-dark">
                {item.period}
              </span>
            </div>
            <h3 class="font-serif text-xl font-semibold text-ink-primary-light dark:text-ink-primary-dark leading-snug">
              {item.title}
            </h3>
            <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed">
              {item.description}
            </p>
            <div class="pt-3 border-t border-borderline-light/50 dark:border-borderline-dark/50 text-xs text-ink-secondary-light dark:text-ink-secondary-dark">
              <strong class="text-ink-primary-light dark:text-ink-primary-dark">Methodology:</strong> {item.methodology}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 3: Research Methodologies -->
    <section>
      <div class="mb-8 pb-3 border-b border-borderline-light dark:border-borderline-dark">
        <h2 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
          Applied Research Methodologies
        </h2>
        <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
          Methodological frameworks employed across system design, modeling, and empirical benchmarking
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {researchData.methodologies.map((method) => (
          <div class="p-6 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark space-y-2">
            <h3 class="font-serif text-base font-semibold text-ink-primary-light dark:text-ink-primary-dark">
              {method.name}
            </h3>
            <p class="text-xs sm:text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed">
              {method.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 4: Roadmap -->
    <section>
      <div class="mb-8 pb-3 border-b border-borderline-light dark:border-borderline-dark">
        <h2 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
          Research Roadmap
        </h2>
        <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
          Strategic timeline for computing investigations, enterprise integrations, and digital governance
        </p>
      </div>

      <div class="space-y-4">
        {researchData.roadmap.map((step) => (
          <div class="p-5 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="flex items-center space-x-2 text-xs">
                <span class="font-semibold text-accent-light dark:text-accent-dark">
                  {step.phase}
                </span>
                <span>•</span>
                <span class={`font-medium ${step.status === 'Completed' ? 'text-emerald-600 dark:text-emerald-400' : 'text-blue-600 dark:text-blue-400'}`}>
                  {step.status}
                </span>
              </div>
              <h3 class="font-serif text-base font-semibold text-ink-primary-light dark:text-ink-primary-dark">
                {step.title}
              </h3>
              <p class="text-xs sm:text-sm text-ink-secondary-light dark:text-ink-secondary-dark">
                {step.summary}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</PageLayout>
