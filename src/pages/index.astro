---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import ArticleCard from '../components/ArticleCard.astro';
import profileData from '../data/profile.json';
import socialData from '../data/social.json';
import siteData from '../data/site.json';
import navigation from '../data/navigation.json';
import researchData from '../data/research.json';
import publicationsData from '../data/publications.json';
import projectsData from '../data/projects.json';
import { getCollection } from 'astro:content';

// Fetch non-draft blog posts (Indonesian)
const allPosts = await getCollection('blog', ({ data }) => !data.draft && (data.lang ?? 'id') === 'id');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = sortedPosts.find((p) => p.data.featured) || sortedPosts[0];
const recentPosts = sortedPosts.filter((p) => p.slug !== featuredPost?.slug).slice(0, 4);

const selectedPublications = publicationsData.filter((p) => p.featured).slice(0, 3);
const selectedProjects = projectsData.filter((p) => p.featured).slice(0, 3);
---

<BaseLayout
  title={`${profileData.brand} — ${profileData.hero.headline}`}
  description={siteData.description}
>
  <!-- Hero Section -->
  <section class="border-b border-borderline-light dark:border-borderline-dark py-16 sm:py-24 bg-surface-light dark:bg-surface-dark transition-colors">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-8 space-y-6">
          <div class="inline-flex items-center space-x-2 text-xs uppercase tracking-widest font-semibold text-accent-light dark:text-accent-dark bg-accent-muted px-3 py-1 rounded-full">
            <span>{profileData.brand}</span>
            <span>•</span>
            <span>Personal Knowledge Hub</span>
          </div>

          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-ink-primary-light dark:text-ink-primary-dark leading-[1.15]">
            {profileData.hero.headline}
          </h1>

          <p class="text-lg sm:text-xl text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed max-w-2xl font-normal">
            {profileData.hero.subheadline}
          </p>

          <div class="pt-4 flex flex-wrap gap-4 items-center">
            <a
              href={profileData.hero.ctaLink}
              class="px-6 py-3 rounded-md bg-accent-light text-white font-medium hover:bg-accent-hover dark:bg-accent-dark dark:text-canvas-dark dark:hover:bg-accent-light transition-all text-sm shadow-sm"
            >
              {profileData.hero.ctaText} &rarr;
            </a>
            <a
              href={profileData.hero.secondaryCtaLink}
              class="px-6 py-3 rounded-md border border-borderline-light dark:border-borderline-dark text-ink-primary-light dark:text-ink-primary-dark hover:border-accent-light dark:hover:border-accent-dark transition-all text-sm font-medium"
            >
              {profileData.hero.secondaryCtaText}
            </a>
          </div>
        </div>

        <!-- Hero Author Card -->
        <div class="lg:col-span-4 flex justify-center lg:justify-end">
          <div class="w-full max-w-xs p-6 rounded-lg border border-borderline-light dark:border-borderline-dark bg-canvas-light dark:bg-canvas-dark text-center space-y-4">
            <div class="w-28 h-28 mx-auto rounded-full overflow-hidden border-2 border-accent-light dark:border-accent-dark p-0.5 bg-surface-light dark:bg-surface-dark">
              <img
                src={profileData.avatar}
                alt={profileData.name}
                class="w-full h-full object-cover rounded-full"
                loading="eager"
              />
            </div>
            <div>
              <h2 class="font-serif text-lg font-bold text-ink-primary-light dark:text-ink-primary-dark">
                {profileData.name}
              </h2>
              <p class="text-xs text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
                {profileData.headline}
              </p>
            </div>
            <p class="text-xs text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed line-clamp-3">
              {profileData.shortBio}
            </p>
            <div class="pt-2 border-t border-borderline-light dark:border-borderline-dark flex justify-center space-x-3 text-xs font-semibold text-accent-light dark:text-accent-dark">
              <a href="/about" class="hover:underline">Biografi Lengkap &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Topics Bar -->
  <section class="border-b border-borderline-light dark:border-borderline-dark py-6 bg-canvas-light dark:bg-canvas-dark transition-colors">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <span class="text-xs uppercase tracking-wider font-semibold text-ink-secondary-light dark:text-ink-secondary-dark">
          Pilar Kajian Utama:
        </span>
        <div class="flex flex-wrap gap-2">
          {navigation.categories.slice(0, 5).map((cat) => (
            <a
              href={`/blog?category=${encodeURIComponent(cat.name)}`}
              class="text-xs px-3 py-1 rounded bg-surface-light dark:bg-surface-dark border border-borderline-light dark:border-borderline-dark text-ink-primary-light dark:text-ink-primary-dark hover:border-accent-light dark:hover:border-accent-dark transition-colors"
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Container -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">
    <!-- Featured Article Section -->
    {featuredPost && (
      <section>
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-borderline-light dark:border-borderline-dark">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
              Artikel Sorotan
            </h2>
            <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
              Kajian mendalam dan analisis pilihan untuk dibaca pekan ini
            </p>
          </div>
        </div>

        <FeaturedArticle
          title={featuredPost.data.title}
          description={featuredPost.data.description}
          slug={featuredPost.slug}
          pubDate={featuredPost.data.pubDate}
          category={featuredPost.data.category}
          tags={featuredPost.data.tags}
          cover={featuredPost.data.cover}
          coverAlt={featuredPost.data.coverAlt}
          body={featuredPost.body}
        />
      </section>
    )}

    <!-- Recent Articles Grid -->
    {recentPosts.length > 0 && (
      <section>
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-borderline-light dark:border-borderline-dark">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
              Publikasi Blog Terbaru
            </h2>
            <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
              Eksplorasi terkini seputar sistem informasi, teknologi, dan riset terapan
            </p>
          </div>
          <a
            href="/blog"
            class="text-xs sm:text-sm font-semibold text-accent-light dark:text-accent-dark hover:underline flex items-center space-x-1"
          >
            <span>Semua Artikel</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {recentPosts.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              slug={post.slug}
              pubDate={post.data.pubDate}
              category={post.data.category}
              tags={post.data.tags}
              cover={post.data.cover}
              coverAlt={post.data.coverAlt}
              body={post.body}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Research Interests Overview -->
    <section class="bg-surface-light dark:bg-surface-dark border border-borderline-light dark:border-borderline-dark rounded-lg p-8 sm:p-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b border-borderline-light dark:border-borderline-dark gap-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-accent-light dark:text-accent-dark block mb-2">
            Pusat Riset Akademik
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
            Fokus &amp; Minat Penelitian
          </h2>
        </div>
        <a
          href="/research"
          class="text-xs sm:text-sm font-semibold text-accent-light dark:text-accent-dark hover:underline"
        >
          Lihat Roadmap Riset &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {researchData.interests.slice(0, 4).map((interest) => (
          <div class="p-5 rounded-md border border-borderline-light dark:border-borderline-dark bg-canvas-light dark:bg-canvas-dark space-y-2">
            <h3 class="font-serif text-lg font-semibold text-ink-primary-light dark:text-ink-primary-dark">
              {interest.title}
            </h3>
            <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed">
              {interest.description}
            </p>
            <div class="pt-2 flex flex-wrap gap-1.5">
              {interest.tags.map((tag) => (
                <span class="text-[10px] px-2 py-0.5 rounded bg-surface-light dark:bg-surface-dark border border-borderline-light dark:border-borderline-dark text-ink-secondary-light dark:text-ink-secondary-dark">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Selected Publications Section -->
    <section>
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-borderline-light dark:border-borderline-dark">
        <div>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
            Publikasi Ilmiah Pilihan
          </h2>
          <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
            Artikel jurnal dan prosiding konferensi yang telah ditelaah sejawat
          </p>
        </div>
        <a
          href="/publications"
          class="text-xs sm:text-sm font-semibold text-accent-light dark:text-accent-dark hover:underline flex items-center space-x-1"
        >
          <span>Daftar Publikasi</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="space-y-4">
        {selectedPublications.map((pub) => (
          <article class="p-6 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark hover:border-accent-light dark:hover:border-accent-dark transition-all">
            <div class="flex flex-wrap items-center gap-2 text-xs text-ink-secondary-light dark:text-ink-secondary-dark mb-2">
              <span class="px-2 py-0.5 rounded bg-accent-muted text-accent-light dark:text-accent-dark font-semibold text-[11px]">
                {pub.type}
              </span>
              <span>•</span>
              <span>{pub.year}</span>
              <span>•</span>
              <span class="font-medium text-ink-primary-light dark:text-ink-primary-dark">{pub.venue}</span>
            </div>
            <h3 class="font-serif text-lg font-bold text-ink-primary-light dark:text-ink-primary-dark mb-2">
              <a href={pub.url} class="hover:text-accent-light dark:hover:text-accent-dark transition-colors">
                {pub.title}
              </a>
            </h3>
            <p class="text-xs text-ink-secondary-light dark:text-ink-secondary-dark mb-3">
              Penulis: {pub.authors.join(', ')}
            </p>
            <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed line-clamp-2">
              {pub.abstract}
            </p>
            {pub.doi && (
              <div class="mt-3 pt-3 border-t border-borderline-light/50 dark:border-borderline-dark/50 text-xs">
                <span class="text-ink-secondary-light dark:text-ink-secondary-dark">DOI: </span>
                <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" class="font-mono text-accent-light dark:text-accent-dark hover:underline">
                  {pub.doi}
                </a>
              </div>
            )}
          </article>
        ))}
      </div>

      <!-- Academic Indexing Badges Bar -->
      <div class="mt-6 p-4 rounded-lg border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
        <span class="font-medium text-ink-secondary-light dark:text-ink-secondary-dark">
          Profil Sitasi &amp; Indeksasi Ilmiah:
        </span>
        <div class="flex flex-wrap items-center gap-3 font-semibold text-accent-light dark:text-accent-dark">
          <a href={socialData.sinta} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center space-x-1">
            <span>SINTA</span>
            <span>&rarr;</span>
          </a>
          <span class="text-borderline-light dark:text-borderline-dark hidden sm:inline">•</span>
          <a href={socialData.scopus} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center space-x-1">
            <span>Scopus</span>
            <span>&rarr;</span>
          </a>
          <span class="text-borderline-light dark:text-borderline-dark hidden sm:inline">•</span>
          <a href={socialData.googleScholar} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center space-x-1">
            <span>Google Scholar</span>
            <span>&rarr;</span>
          </a>
          <span class="text-borderline-light dark:text-borderline-dark hidden sm:inline">•</span>
          <a href={socialData.orcid} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center space-x-1">
            <span>ORCID</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Selected Projects Section -->
    <section>
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-borderline-light dark:border-borderline-dark">
        <div>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
            Proyek &amp; Inovasi Digital
          </h2>
          <p class="text-sm text-ink-secondary-light dark:text-ink-secondary-dark mt-1">
            Implementasi rekayasa perangkat lunak dan arsitektur sistem informasi terapan
          </p>
        </div>
        <a
          href="/projects"
          class="text-xs sm:text-sm font-semibold text-accent-light dark:text-accent-dark hover:underline flex items-center space-x-1"
        >
          <span>Semua Proyek</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {selectedProjects.map((project) => (
          <div class="flex flex-col justify-between p-6 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark hover:border-accent-light dark:hover:border-accent-dark transition-all">
            <div>
              <div class="flex items-center justify-between text-xs mb-3">
                <span class="text-[11px] font-semibold text-accent-light dark:text-accent-dark">
                  {project.status}
                </span>
              </div>
              <h3 class="font-serif text-lg font-bold text-ink-primary-light dark:text-ink-primary-dark mb-2">
                {project.title}
              </h3>
              <p class="text-xs sm:text-sm text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed mb-4">
                {project.description}
              </p>
            </div>
            <div>
              <div class="flex flex-wrap gap-1.5 mb-4">
                {project.techStack.map((tech) => (
                  <span class="text-[10px] px-2 py-0.5 rounded bg-canvas-light dark:bg-canvas-dark border border-borderline-light dark:border-borderline-dark text-ink-secondary-light dark:text-ink-secondary-dark">
                    {tech}
                  </span>
                ))}
              </div>
              <a
                href={project.url}
                class="text-xs font-semibold text-accent-light dark:text-accent-dark hover:underline"
              >
                Lihat Detail Proyek &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact & Collaboration Invitation -->
    <section class="border border-borderline-light dark:border-borderline-dark rounded-xl p-8 sm:p-14 bg-surface-light dark:bg-surface-dark text-center space-y-6">
      <div class="max-w-2xl mx-auto space-y-4">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-ink-primary-light dark:text-ink-primary-dark">
          Tertarik Berkolaborasi atau Diskusi Akademik?
        </h2>
        <p class="text-base text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed">
          Saya selalu terbuka untuk berdiskusi seputar riset sistem informasi, pemodelan arsitektur perangkat lunak, maupun peluang kerjasama akademis dan konsultasi transformasi digital.
        </p>
        <div class="pt-4 flex flex-wrap justify-center gap-4">
          <a
            href="/contact"
            class="px-6 py-3 rounded-md bg-accent-light text-white font-medium hover:bg-accent-hover dark:bg-accent-dark dark:text-canvas-dark dark:hover:bg-accent-light transition-all text-sm"
          >
            Hubungi Saya
          </a>
          <a
            href={socialData.github}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-md border border-borderline-light dark:border-borderline-dark text-ink-primary-light dark:text-ink-primary-dark hover:border-accent-light dark:hover:border-accent-dark transition-all text-sm font-medium"
          >
            Kunjungi GitHub
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
