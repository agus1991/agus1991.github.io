---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SocialShare from '../components/SocialShare.astro';
import ArticleAd from '../components/ArticleAd.astro';
import SidebarAd from '../components/SidebarAd.astro';
import { formatDate } from '../utils/formatDate';
import { calculateReadingTime } from '../utils/readingTime';
import { generateBlogPostingSchema } from '../utils/seo';
import profileData from '../data/profile.json';
import siteData from '../data/site.json';
import { getLangFromUrl, useTranslations, type SupportedLang } from '../i18n/ui';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface ArticleNav {
  title: string;
  slug: string;
}

interface RelatedPost {
  title: string;
  slug: string;
  category: string;
  pubDate: Date;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  updatedDate?: Date | string;
  category: string;
  tags?: string[];
  cover?: string;
  coverAlt?: string;
  headings?: Heading[];
  slug: string;
  rawContent?: string;
  prevPost?: ArticleNav | null;
  nextPost?: ArticleNav | null;
  relatedPosts?: RelatedPost[];
  lang?: SupportedLang;
  translationSlug?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags = [],
  cover,
  coverAlt = title,
  headings = [],
  slug,
  rawContent = '',
  prevPost = null,
  nextPost = null,
  relatedPosts = [],
  lang,
  translationSlug
} = Astro.props;

const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const isEn = currentLang === 'en';

const articlePrefix = isEn ? '/en/blog' : '/blog';
const canonicalUrl = `${siteData.siteUrl}${articlePrefix}/${slug}`;
const readingTime = calculateReadingTime(rawContent || description);
const formattedPubDate = formatDate(pubDate);
const formattedUpDate = updatedDate ? formatDate(updatedDate) : null;

// Multilingual alternate linking for Google SEO
const alternateUrl = isEn
  ? {
      id: translationSlug ? `/blog/${translationSlug}` : '/blog',
      en: `/en/blog/${slug}`
    }
  : {
      id: `/blog/${slug}`,
      en: translationSlug ? `/en/blog/${translationSlug}` : '/en/blog'
    };

const breadcrumbs = isEn
  ? [
      { name: t('nav.home'), url: '/en' },
      { name: t('nav.blog'), url: '/en/blog' },
      { name: category, url: `/en/blog?category=${encodeURIComponent(category)}` },
      { name: title, url: `/en/blog/${slug}` }
    ]
  : [
      { name: t('nav.home'), url: '/' },
      { name: t('nav.blog'), url: '/blog' },
      { name: category, url: `/blog?category=${encodeURIComponent(category)}` },
      { name: title, url: `/blog/${slug}` }
    ];

const blogPostingSchema = generateBlogPostingSchema({
  title,
  description,
  url: canonicalUrl,
  pubDate,
  updatedDate,
  cover,
  category,
  tags
});
---

<BaseLayout
  title={title}
  description={description}
  image={cover}
  article={true}
  pubDate={pubDate}
  updatedDate={updatedDate}
  canonicalUrl={canonicalUrl}
  schemas={[blogPostingSchema]}
  lang={currentLang}
  alternateUrl={alternateUrl}
>
  <ReadingProgress />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumb -->
    <div class="mb-6">
      <Breadcrumb items={breadcrumbs} />
    </div>

    <!-- Article Header -->
    <header class="mb-10 text-center sm:text-left">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 text-xs text-ink-secondary-light dark:text-ink-secondary-dark mb-4">
        <a
          href={`${articlePrefix}?category=${encodeURIComponent(category)}`}
          class="font-semibold text-accent-light dark:text-accent-dark uppercase tracking-wider text-[11px] px-2.5 py-0.5 rounded-full bg-accent-muted"
        >
          {category}
        </a>
        <span>•</span>
        <time datetime={new Date(pubDate).toISOString()}>{formattedPubDate}</time>
        {formattedUpDate && formattedUpDate !== formattedPubDate && (
          <>
            <span>•</span>
            <span class="italic text-[11px]">({isEn ? 'Updated' : 'Diperbarui'}: {formattedUpDate})</span>
          </>
        )}
        <span>•</span>
        <span>{readingTime}</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink-primary-light dark:text-ink-primary-dark leading-[1.2] mb-6">
        {title}
      </h1>

      <p class="text-lg sm:text-xl text-ink-secondary-light dark:text-ink-secondary-dark leading-relaxed font-normal">
        {description}
      </p>

      {/* Language Switch Callout Badge if translation available */}
      {translationSlug && (
        <div class="mt-4 p-3 rounded-md border border-accent-light/30 dark:border-accent-dark/30 bg-accent-muted/40 flex items-center justify-between text-xs">
          <span class="text-ink-secondary-light dark:text-ink-secondary-dark">
            {isEn ? 'Artikel ini juga tersedia dalam Bahasa Indonesia.' : 'This article is also available in English.'}
          </span>
          <a
            href={isEn ? `/blog/${translationSlug}` : `/en/blog/${translationSlug}`}
            class="font-semibold text-accent-light dark:text-accent-dark hover:underline flex items-center space-x-1"
          >
            <span>{isEn ? 'Baca dalam Bahasa Indonesia' : 'Read in English'}</span>
            <span>&rarr;</span>
          </a>
        </div>
      )}

      <!-- Author Bar -->
      <div class="mt-8 pt-6 border-t border-borderline-light dark:border-borderline-dark flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <img
            src={profileData.avatar}
            alt={profileData.name}
            class="w-11 h-11 rounded-full border border-borderline-light dark:border-borderline-dark object-cover"
          />
          <div>
            <a href={isEn ? '/en/about' : '/about'} class="text-sm font-semibold text-ink-primary-light dark:text-ink-primary-dark hover:text-accent-light dark:hover:text-accent-dark transition-colors">
              {profileData.name}
            </a>
            <p class="text-xs text-ink-secondary-light dark:text-ink-secondary-dark">
              {profileData.headline}
            </p>
          </div>
        </div>

        <a href={isEn ? '/en/about' : '/about'} class="text-xs text-accent-light dark:text-accent-dark hover:underline font-medium hidden sm:inline-block">
          {isEn ? 'Author Profile →' : 'Profil Penulis →'}
        </a>
      </div>
    </header>

    <!-- Featured Image -->
    {cover && (
      <figure class="mb-10 mx-auto w-full rounded-lg overflow-hidden border border-borderline-light dark:border-borderline-dark aspect-[1200/630] bg-canvas-light dark:bg-canvas-dark text-center">
        <img
          src={cover}
          alt={coverAlt}
          class="w-full h-full object-cover block mx-auto"
          loading="eager"
          decoding="async"
        />
        {coverAlt && coverAlt !== title && (
          <figcaption class="p-3 text-center text-xs text-ink-secondary-light dark:text-ink-secondary-dark bg-surface-light dark:bg-surface-dark border-t border-borderline-light dark:border-borderline-dark">
            {coverAlt}
          </figcaption>
        )}
      </figure>
    )}

    <!-- AdSense Slot: Top of Article -->
    <ArticleAd position="top" />

    <!-- Table of Contents -->
    {headings && headings.length > 0 && (
      <TableOfContents headings={headings} />
    )}

    <!-- Main Content Body -->
    <div class="prose prose-lg dark:prose-invert max-w-none my-10 leading-relaxed">
      <slot />
    </div>

    <!-- AdSense Slot: Middle/Bottom of Article -->
    <ArticleAd position="bottom" />

    <!-- Tags List -->
    {tags.length > 0 && (
      <div class="my-8 pt-6 border-t border-borderline-light dark:border-borderline-dark">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-ink-secondary-light dark:text-ink-secondary-dark mb-3">
          {isEn ? 'Related Topics:' : 'Topik Terkait:'}
        </h4>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`${articlePrefix}?tag=${encodeURIComponent(tag)}`}
              class="text-xs px-3 py-1 rounded bg-surface-light dark:bg-surface-dark border border-borderline-light dark:border-borderline-dark text-ink-secondary-light dark:text-ink-secondary-dark hover:border-accent-light dark:hover:border-accent-dark hover:text-accent-light dark:hover:text-accent-dark transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Social Share -->
    <SocialShare title={title} url={canonicalUrl} />

    <!-- Previous and Next Post Navigation -->
    <nav class="my-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prevPost ? (
        <a
          href={`${articlePrefix}/${prevPost.slug}`}
          class="p-4 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark hover:border-accent-light dark:hover:border-accent-dark transition-all group"
        >
          <span class="block text-xs uppercase tracking-wider text-ink-secondary-light dark:text-ink-secondary-dark mb-1">
            &larr; {isEn ? 'Previous Article' : 'Artikel Sebelumnya'}
          </span>
          <span class="font-serif text-sm font-semibold text-ink-primary-light dark:text-ink-primary-dark group-hover:text-accent-light dark:group-hover:text-accent-dark line-clamp-2">
            {prevPost.title}
          </span>
        </a>
      ) : <div />}

      {nextPost ? (
        <a
          href={`${articlePrefix}/${nextPost.slug}`}
          class="p-4 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark hover:border-accent-light dark:hover:border-accent-dark transition-all text-right group"
        >
          <span class="block text-xs uppercase tracking-wider text-ink-secondary-light dark:text-ink-secondary-dark mb-1">
            {isEn ? 'Next Article' : 'Artikel Selanjutnya'} &rarr;
          </span>
          <span class="font-serif text-sm font-semibold text-ink-primary-light dark:text-ink-primary-dark group-hover:text-accent-light dark:group-hover:text-accent-dark line-clamp-2">
            {nextPost.title}
          </span>
        </a>
      ) : <div />}
    </nav>

    <!-- Related Articles -->
    {relatedPosts.length > 0 && (
      <section class="mt-14 pt-10 border-t border-borderline-light dark:border-borderline-dark">
        <h3 class="font-serif text-2xl font-bold text-ink-primary-light dark:text-ink-primary-dark mb-6">
          {isEn ? 'Related Recommended Articles' : 'Artikel Pilihan Terkait'}
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {relatedPosts.map((post) => (
            <a
              href={`${articlePrefix}/${post.slug}`}
              class="p-5 rounded-md border border-borderline-light dark:border-borderline-dark bg-surface-light dark:bg-surface-dark hover:border-accent-light dark:hover:border-accent-dark transition-all group"
            >
              <span class="text-[11px] font-semibold text-accent-light dark:text-accent-dark uppercase tracking-wider block mb-1">
                {post.category}
              </span>
              <h4 class="font-serif text-base font-semibold text-ink-primary-light dark:text-ink-primary-dark group-hover:text-accent-light dark:group-hover:text-accent-dark line-clamp-2">
                {post.title}
              </h4>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  <!-- Interactive Copy Code Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const codeBlocks = document.querySelectorAll('.prose pre');
      codeBlocks.forEach((pre) => {
        if (pre.querySelector('.copy-code-btn')) return;

        pre.style.position = 'relative';

        const button = document.createElement('button');
        button.className = 'copy-code-btn';
        button.type = 'button';
        button.setAttribute('aria-label', 'Salin baris kode');
        button.innerHTML = `
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="copy-text">Salin</span>
        `;

        button.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          const textToCopy = code ? code.innerText : pre.innerText;

          try {
            await navigator.clipboard.writeText(textToCopy);
            button.classList.add('copied');
            button.innerHTML = `
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="copy-text">Tersalin!</span>
            `;
            setTimeout(() => {
              button.classList.remove('copied');
              button.innerHTML = `
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span class="copy-text">Salin</span>
              `;
            }, 2000);
          } catch (err) {
            console.error('Gagal menyalin kode:', err);
          }
        });

        pre.appendChild(button);
      });
    });
  </script>
</BaseLayout>
